# Copiez ce fichier en .env puis adaptez-le :  cp .env.example .env

# Port exposé sur la machine (cible de votre reverse proxy)
HOST_PORT=3001
# 127.0.0.1 si Nginx tourne sur la même machine ; 0.0.0.0 s'il est ailleurs (autre conteneur/VM)
HOST_BIND=0.0.0.0
MAX_PLAYERS_PER_ROOM=8
# Délai (ms) avant de retirer un joueur déconnecté
RECONNECT_GRACE_MS=60000

# ---------- Connexion Discord (laisser CLIENT_ID/SECRET vides = pseudo libre, sans connexion)
# Même application Discord que JDR-WEB possible : https://discord.com/developers/applications
# Dans OAuth2 > Redirects, ajouter : ${PUBLIC_URL}/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Adresse publique du site (celle servie par votre Nginx)
PUBLIC_URL=https://jeux.mondomaine.fr
# 32 caractères minimum : openssl rand -base64 48
SESSION_SECRET=

# Qui peut jouer (tout vide = n'importe quel compte Discord)
# ID de votre serveur Discord : seuls ses membres peuvent jouer
DISCORD_GUILD_ID=
# Optionnel : en plus, il faut un de ces rôles (IDs séparés par des virgules)
DISCORD_ROLE_IDS=
# Optionnel : comptes autorisés quoi qu'il arrive (IDs utilisateurs séparés par des virgules)
DISCORD_ALLOWED_IDS=
