# Copiez ce fichier en .env puis adaptez-le :  cp .env.example .env

# ---------- Application
# Port d'accès direct : http://IP-de-la-machine:3000
HOST_PORT=3000
# Mettre 127.0.0.1 quand Caddy ou Cloudflare est devant (ferme l'accès direct)
HOST_BIND=0.0.0.0
MAX_PLAYERS_PER_ROOM=8
# Délai (ms) avant de retirer un joueur déconnecté
RECONNECT_GRACE_MS=60000

# ---------- Option A : HTTPS avec Caddy   ->  docker compose --profile https up -d --build
DOMAIN=jeux.mondomaine.fr

# ---------- Option B : Tunnel Cloudflare  ->  docker compose --profile tunnel up -d --build
CLOUDFLARE_TUNNEL_TOKEN=
