# Copiez ce fichier en .env puis adaptez-le :  cp .env.example .env

# Port exposé sur la machine (cible de votre reverse proxy)
HOST_PORT=3001
# 127.0.0.1 si Nginx tourne sur la même machine ; 0.0.0.0 s'il est ailleurs (autre conteneur/VM)
HOST_BIND=0.0.0.0
MAX_PLAYERS_PER_ROOM=8
# Délai (ms) avant de retirer un joueur déconnecté
RECONNECT_GRACE_MS=60000

# ---------- Connexion Discord (sans CLIENT_ID/SECRET = pseudo libre, sans connexion)
# Dans l'app Discord (https://discord.com/developers/applications) > OAuth2 > Redirects,
# ajouter : ${PUBLIC_URL}/auth/discord/callback
# Adresse publique du site (celle servie par votre Nginx)
PUBLIC_URL=https://jeux.mondomaine.fr

# Réutiliser la config Discord de JDR-WEB (dossier voisin) : CLIENT_ID/SECRET, secret de
# session (une clé propre au Hub en est dérivée) et ADMIN_DISCORD_IDS (toujours autorisés).
# Rien d'autre n'est lu dans ce fichier. Laisser vide si vous remplissez les lignes suivantes.
SHARED_ENV_FILE=../light-jdr/.env

# ... ou bien une config propre au Hub (prioritaire sur SHARED_ENV_FILE) :
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 32 caractères minimum : openssl rand -base64 48
SESSION_SECRET=

# Administrateurs du Hub (valident les demandes d'accès). Ceux de light-jdr le sont aussi.
# Votre ID : Discord > Paramètres > Avancés > Mode développeur, puis clic droit sur votre profil > Copier l'identifiant.
ADMIN_DISCORD_IDS=
# true : chaque nouveau compte attend votre validation (page Hub > Demandes d'accès)
ACCESS_APPROVAL=true

# Filtres optionnels avant la demande (tout vide = n'importe quel compte Discord peut demander)
# ID de votre serveur Discord : seuls ses membres peuvent jouer
DISCORD_GUILD_ID=
# Optionnel : en plus, il faut un de ces rôles (IDs séparés par des virgules)
DISCORD_ROLE_IDS=
# Optionnel : comptes acceptés sans validation (IDs utilisateurs séparés par des virgules)
DISCORD_ALLOWED_IDS=
