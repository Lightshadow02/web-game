# Caddy obtient et renouvelle seul le certificat HTTPS pour {$DOMAIN}.

{$DOMAIN} {
	encode zstd gzip

	# Les WebSockets (Socket.io) passent automatiquement.
	reverse_proxy game-hub:3000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
